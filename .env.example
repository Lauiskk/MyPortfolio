# Every variable here is OPTIONAL. Each feature hides itself when its key is
# missing, so the site works on a fresh deploy with an empty .env.

# GitHub — live repo stats + the contribution grid the snake is played on.
# Create at https://github.com/settings/tokens with scope: read:user
GITHUB_TOKEN=

# Twitch — the pulsing LIVE badge. https://dev.twitch.tv/console/apps
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=

# Spotify — the "now playing" badge. Run `node scripts/spotify-token.mjs` once
# to obtain the refresh token. https://developer.spotify.com/dashboard
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REFRESH_TOKEN=

# Resend — the contact form. Without it the form is replaced by a mailto link.
RESEND_API_KEY=
CONTACT_TO_EMAIL=vrluis157@gmail.com

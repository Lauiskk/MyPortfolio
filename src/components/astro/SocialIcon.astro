---
/** Inline 24×24 stroke icons — replaces the Font Awesome CDN dependency. */
interface Props { name: string; size?: number }
const { name, size = 17 } = Astro.props;

const paths: Record<string, string> = {
  github:
    'M9 19c-5 1.5-5-2.5-7-3m14 6v-3.9a3.4 3.4 0 0 0-.9-2.6c3-.3 6.2-1.5 6.2-6.7A5.2 5.2 0 0 0 19.9 5a4.9 4.9 0 0 0-.1-3.6s-1.1-.3-3.7 1.4a12.7 12.7 0 0 0-6.6 0C6.9 1.1 5.8 1.4 5.8 1.4A4.9 4.9 0 0 0 5.7 5a5.2 5.2 0 0 0-1.4 3.7c0 5.2 3.2 6.4 6.2 6.7a3.4 3.4 0 0 0-.9 2.6V22',
  linkedin: 'M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-4 0v7h-4v-13h4v1.8A6 6 0 0 1 16 8zM6 9H2v12h4z|circle:4,4,2',
  mail: 'M3 6h18v12H3z|M3 7l9 6 9-6',
  whatsapp:
    'M3 21l1.7-4.5A8.3 8.3 0 1 1 7.8 19.7L3 21z|M8.6 9.2c.3-.7.6-.7.9-.7h.7c.2 0 .5 0 .8.6l.9 2c.1.3.1.5 0 .7l-.4.6c-.1.2-.3.4-.1.7a7 7 0 0 0 3.2 2.8c.3.1.5.1.7-.1l.6-.7c.2-.2.4-.2.7-.1l2 1c.3.1.5.3.5.5v.7c0 .8-.7 1.5-1.6 1.6-1 .1-3.5-.3-6-2.8s-2.9-5-2.8-6c.1-.9.8-1.6 1.6-1.6',
  twitch: 'M4 3h17v11l-4.5 4.5H13L10 21H8v-2.5H4V3z|M11 8v5M16 8v5',
  instagram: 'M3 3h18v18H3z|circle:12,12,4.2|circle:17.2,6.8,0.9',
  youtube: 'M2 12c0-3 .3-4.3.8-5 .4-.5 1-.8 1.7-.9C6.2 6 12 6 12 6s5.8 0 7.5.1c.7.1 1.3.4 1.7.9.5.7.8 2 .8 5s-.3 4.3-.8 5c-.4.5-1 .8-1.7.9C17.8 18 12 18 12 18s-5.8 0-7.5-.1a2.4 2.4 0 0 1-1.7-.9c-.5-.7-.8-2-.8-5z|M10 9.2l5 2.8-5 2.8z',
  twitter: 'M3 3l7.6 10.2L3.5 21h1.9l6-6.6 4.9 6.6H21l-8-10.8L20.4 3h-1.9l-5.6 6.2L8.3 3H3z',
  external: 'M14 3h7v7|M21 3l-9 9|M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6',
  code: 'M8 6l-6 6 6 6M16 6l6 6-6 6',
  // Shown instead of a GitHub link when the source is private or unpublished.
  lock: 'M5 11h14v10H5z|M8 11V7a4 4 0 0 1 8 0v4',
};

const raw = paths[name] ?? paths.external;
const parts = raw.split('|');
---
<svg
  viewBox="0 0 24 24"
  width={size}
  height={size}
  fill="none"
  stroke="currentColor"
  stroke-width="1.7"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
>
  {parts.map((p) =>
    p.startsWith('circle:')
      ? (() => {
          const [cx, cy, r] = p.slice(7).split(',');
          return <circle cx={cx} cy={cy} r={r} />;
        })()
      : <path d={p} />,
  )}
</svg>

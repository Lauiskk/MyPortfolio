---
import { useTranslations, alternateFor, localizePath, type Lang } from '../../i18n/ui';
import { profile } from '../../data/profile';
import LiveBadge from '../react/LiveBadge.tsx';
import CommandPalette from '../react/CommandPalette.tsx';
import { nowEnabled } from '../../lib/env';

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = useTranslations(lang);
const alt = alternateFor(Astro.url, lang);
const home = localizePath('/', lang);
const showNow = nowEnabled();

const links = [
  { id: 'about', label: t('nav.about') },
  { id: 'experience', label: t('nav.experience') },
  { id: 'projects', label: t('nav.projects') },
  { id: 'system', label: t('nav.system') },
  { id: 'skills', label: t('nav.skills') },
  { id: 'snake', label: t('nav.snake') },
  { id: 'terminal', label: t('nav.terminal') },
  ...(showNow ? [{ id: 'now', label: t('nav.now') }] : []),
  { id: 'contact', label: t('nav.contact') },
];
---
<header
  id="navbar"
  class="fixed inset-x-0 top-0 z-[9000] border-b border-transparent transition-[background-color,border-color,transform] duration-500"
  data-nav
>
  <nav class="mx-auto flex h-[68px] max-w-[1240px] items-center gap-5 px-5" aria-label="Primary">
    <a href={home} class="group flex items-baseline gap-2" data-cursor-label="home">
      <span class="font-display text-2xl font-black tracking-tight text-[var(--accent)] glitch-hover">
        {profile.initials}
      </span>
      <span class="hidden font-mono text-[0.65rem] uppercase tracking-[0.25em] text-[var(--ink-3)] sm:inline">
        /dev
      </span>
    </a>

    <LiveBadge client:idle lang={lang} />

    <ul class="ml-auto hidden items-center gap-1 lg:flex">
      {links.map((l) => (
        <li>
          <a
            href={`${home === '/' ? '' : home}#${l.id}`}
            data-navlink={l.id}
            class="group relative block px-2.5 py-2 font-mono text-[0.72rem] uppercase tracking-[0.14em] text-[var(--ink-2)] transition-colors hover:text-[var(--accent)]"
          >
            <span>{l.label}</span>
            <span
              class="absolute inset-x-2.5 -bottom-px h-px origin-left scale-x-0 bg-[var(--accent)] transition-transform duration-300 group-hover:scale-x-100"
              aria-hidden="true"></span>
          </a>
        </li>
      ))}
    </ul>

    <div class="ml-auto flex items-center gap-1 lg:ml-0">
      <button
        type="button"
        data-palette-open
        class="hidden items-center gap-2 border border-[var(--hair)] px-3 py-1.5 font-mono text-[0.68rem] text-[var(--ink-3)] transition-colors hover:border-[var(--accent)] hover:text-[var(--accent)] md:flex"
        aria-label="Open command palette"
      >
        <span>⌘</span><span>K</span>
      </button>

      <a
        href={alt.href}
        class="border border-[var(--hair)] px-2.5 py-1.5 font-mono text-[0.68rem] uppercase text-[var(--ink-2)] transition-colors hover:border-[var(--accent)] hover:text-[var(--accent)]"
        aria-label={t('nav.lang')}
        hreflang={alt.lang}
      >
        {alt.lang}
      </a>

      <button type="button" data-sound-toggle class="nav-icon" aria-label={t('nav.sound')} aria-pressed="false">
        <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
          <path d="M11 5 6 9H3v6h3l5 4V5z" />
          <path data-sound-wave d="M15.5 8.5a5 5 0 0 1 0 7M18.5 5.5a9 9 0 0 1 0 13" opacity="0.35" />
          <path data-sound-mute d="m17 9 5 6M22 9l-5 6" />
        </svg>
      </button>

      <button type="button" data-theme-toggle class="nav-icon" aria-label={t('nav.theme')}>
        <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
          <circle cx="12" cy="12" r="4.5" />
          <path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" />
        </svg>
      </button>

      <button type="button" data-menu-toggle class="nav-icon lg:hidden" aria-label={t('nav.menu')} aria-expanded="false" aria-controls="mobile-menu">
        <span class="block h-px w-4 bg-current transition-transform duration-300" data-bar="1"></span>
        <span class="mt-1 block h-px w-4 bg-current transition-opacity duration-300" data-bar="2"></span>
        <span class="mt-1 block h-px w-4 bg-current transition-transform duration-300" data-bar="3"></span>
      </button>
    </div>
  </nav>

  <div
    id="mobile-menu"
    class="panel invisible max-h-0 overflow-hidden border-t border-[var(--hair)] opacity-0 transition-[max-height,opacity,visibility] duration-400 lg:hidden"
    data-mobile-menu
  >
    <ul class="mx-auto max-w-[1240px] px-5 py-4">
      {links.map((l, i) => (
        <li>
          <a
            href={`${home === '/' ? '' : home}#${l.id}`}
            data-navlink={l.id}
            class="flex items-baseline gap-3 border-b border-[var(--hair)] py-3 font-display text-sm uppercase tracking-[0.12em] text-[var(--ink-2)] transition-colors hover:text-[var(--accent)]"
          >
            <span class="font-mono text-[0.65rem] text-[var(--accent)] opacity-60">0{i + 1}</span>
            {l.label}
          </a>
        </li>
      ))}
    </ul>
  </div>
</header>

<CommandPalette client:idle lang={lang} showNow={showNow} />

<style>
  .nav-icon {
    display: grid;
    place-items: center;
    width: 34px;
    height: 34px;
    border: 1px solid var(--hair);
    color: var(--ink-2);
    transition: color 0.25s, border-color 0.25s;
  }
  .nav-icon:hover { color: var(--accent); border-color: var(--accent); }

  [data-nav].is-scrolled {
    background: color-mix(in oklab, var(--surface) 82%, transparent);
    backdrop-filter: blur(14px);
    border-bottom-color: var(--hair);
  }
  [data-nav].is-hidden { transform: translateY(-100%); }

  [data-mobile-menu].is-open {
    visibility: visible;
    max-height: 70vh;
    opacity: 1;
  }
  [data-menu-toggle][aria-expanded='true'] [data-bar='1'] { transform: translateY(5px) rotate(45deg); }
  [data-menu-toggle][aria-expanded='true'] [data-bar='2'] { opacity: 0; }
  [data-menu-toggle][aria-expanded='true'] [data-bar='3'] { transform: translateY(-5px) rotate(-45deg); }

  a[data-navlink].is-active { color: var(--accent); }
</style>

<script>
  import { onView, scrollTo } from '../../lib/motion';
  import { toggleTheme } from '../../lib/theme';
  import { initSound, isSoundOn, setSound, play } from '../../lib/sound';

  onView(() => {
    const nav = document.querySelector<HTMLElement>('[data-nav]');
    const menu = document.querySelector<HTMLElement>('[data-mobile-menu]');
    const menuBtn = document.querySelector<HTMLButtonElement>('[data-menu-toggle]');
    const soundBtn = document.querySelector<HTMLButtonElement>('[data-sound-toggle]');
    if (!nav) return;

    /* Condense on scroll, and hide when scrolling down past the fold. */
    let last = window.scrollY;
    const onScroll = () => {
      const y = window.scrollY;
      nav.classList.toggle('is-scrolled', y > 40);
      nav.classList.toggle('is-hidden', y > 400 && y > last && !menu?.classList.contains('is-open'));
      last = y;
    };
    window.addEventListener('scroll', onScroll, { passive: true });
    onScroll();

    const closeMenu = () => {
      menu?.classList.remove('is-open');
      menuBtn?.setAttribute('aria-expanded', 'false');
    };

    const onMenu = () => {
      const open = menu?.classList.toggle('is-open') ?? false;
      menuBtn?.setAttribute('aria-expanded', String(open));
      play('tick');
    };
    menuBtn?.addEventListener('click', onMenu);

    /* Anchor links go through Lenis so the motion matches the rest. */
    const onClick = (e: MouseEvent) => {
      const link = (e.target as HTMLElement).closest<HTMLAnchorElement>('a[data-navlink]');
      const hash = link?.getAttribute('href')?.split('#')[1];
      if (!link || !hash) return;
      const target = document.getElementById(hash);
      if (!target) return;
      e.preventDefault();
      closeMenu();
      scrollTo(target);
      history.replaceState(null, '', `#${hash}`);
      play('tick');
    };
    document.addEventListener('click', onClick);

    document.querySelector('[data-theme-toggle]')?.addEventListener('click', () => {
      toggleTheme();
      play('tick');
    });

    const paintSound = (on: boolean) => {
      soundBtn?.setAttribute('aria-pressed', String(on));
      soundBtn?.querySelector<SVGElement>('[data-sound-wave]')?.style.setProperty('opacity', on ? '1' : '0.25');
      soundBtn?.querySelector<SVGElement>('[data-sound-mute]')?.style.setProperty('display', on ? 'none' : '');
    };
    paintSound(initSound());
    soundBtn?.addEventListener('click', () => paintSound(setSound(!isSoundOn())));

    /* Scrollspy over the sections the nav points at. */
    const sections = [...document.querySelectorAll<HTMLElement>('section[id]')];
    const spy = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (!entry.isIntersecting) continue;
          document
            .querySelectorAll('a[data-navlink]')
            .forEach((a) => a.classList.toggle('is-active', a.getAttribute('data-navlink') === entry.target.id));
        }
      },
      { rootMargin: '-45% 0px -50% 0px' },
    );
    sections.forEach((s) => spy.observe(s));

    return () => {
      window.removeEventListener('scroll', onScroll);
      document.removeEventListener('click', onClick);
      menuBtn?.removeEventListener('click', onMenu);
      spy.disconnect();
    };
  });
</script>

---
import { useTranslations, type Lang } from '../../i18n/ui';
import Hero from './Hero.astro';
import About from './About.astro';
import ExperienceRail from './ExperienceRail.astro';
import Projects from './Projects.astro';
import Section from './Section.astro';
import Contact from './Contact.astro';
import SkillsConstellation from '../react/SkillsConstellation.tsx';
import SnakeGrid from '../react/SnakeGrid.tsx';
import Terminal from '../react/Terminal.tsx';
import NowPanel from '../react/NowPanel.tsx';
import { nowEnabled } from '../../lib/env';

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = useTranslations(lang);
const showNow = nowEnabled();
---
<Hero lang={lang} />
<About lang={lang} />
<ExperienceRail lang={lang} />
<Projects lang={lang} />

<Section id="skills" index="04" title={t('skills.title')} accent="blue">
  <SkillsConstellation client:visible lang={lang} />
</Section>

<Section id="snake" index="05" title={t('snake.title')} accent="magenta">
  <p class="mb-8 max-w-2xl text-[var(--ink-2)]">{t('snake.lead')}</p>
  <SnakeGrid client:visible lang={lang} />
</Section>

<Section id="terminal" index="06" title={t('terminal.title')} accent="cyan">
  <p class="mb-6 max-w-2xl text-[var(--ink-2)]" set:html={t('terminal.lead')}></p>
  <Terminal client:visible lang={lang} />
</Section>

{showNow && (
  <Section id="now" index="07" title={t('now.title')} accent="purple">
    <p class="mb-8 max-w-2xl text-[var(--ink-2)]">{t('now.lead')}</p>
    <NowPanel client:visible lang={lang} />
  </Section>
)}

<Contact lang={lang} index={showNow ? '08' : '07'} />

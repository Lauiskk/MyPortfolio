---
import { useTranslations, loc, type Lang } from '../../i18n/ui';
import { profile, socials } from '../../data/profile';
import { layers, VIEWBOX } from '../../lib/skyline';
import SocialIcon from './SocialIcon.astro';
import Hologram from '../react/Hologram.tsx';

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = useTranslations(lang);
const roles = profile.roles[lang];
const pitch = loc(profile.heroPitch, lang);
/** **bold** → accented span. Keeps the copy in one place in profile.ts. */
const pitchHtml = pitch.replace(/\*\*(.+?)\*\*/g, '<strong class="text-[var(--ink)] font-semibold">$1</strong>');
const heroSocials = socials.filter((s) => ['github', 'linkedin', 'email', 'twitch'].includes(s.id));
---
<section id="home" data-accent="cyan" class="relative flex min-h-[100svh] items-center overflow-hidden pt-20">
  <!-- ── Parallax stack. Each layer moves at its own rate. ── -->
  <div class="pointer-events-none absolute inset-0" data-parallax-root aria-hidden="true">
    <div class="absolute inset-0 bg-[radial-gradient(120%_80%_at_50%_100%,color-mix(in_oklab,var(--color-purple)_22%,transparent),transparent_60%)]"></div>

    <div class="fx-grid absolute inset-x-0 bottom-0 h-[45%] origin-bottom [mask-image:linear-gradient(to_top,#000,transparent)]"
         style="transform: perspective(320px) rotateX(62deg);" data-layer data-depth="0.05"></div>

    {layers.map((layer) => (
      <svg
        class="absolute inset-x-0 bottom-0 h-[32%] w-full"
        style={`opacity:${layer.opacity}`}
        viewBox={VIEWBOX}
        preserveAspectRatio="xMidYMax slice"
        data-layer
        data-depth={layer.depth}
      >
        <g fill={layer.color}>
          {layer.buildings.map((b) => <rect x={b.x} y={b.y} width={b.w} height={b.h} />)}
        </g>
        <g fill="var(--color-cyan)" opacity="0.75">
          {layer.buildings.flatMap((b) => b.lights.map(([lx, ly]) => <rect x={lx} y={ly} width="3" height="5" />))}
        </g>
      </svg>
    ))}

    <canvas id="particles" class="absolute inset-0 h-full w-full"></canvas>

    <div class="absolute inset-x-0 bottom-0 h-1/3 bg-gradient-to-t from-[var(--surface)] to-transparent"></div>

    <!-- Scrim: the city must never win a contrast fight with the copy. -->
    <div class="absolute inset-y-0 left-0 w-full bg-[radial-gradient(ellipse_60%_70%_at_22%_52%,var(--surface)_38%,transparent_72%)] lg:w-3/5"></div>
  </div>

  <!-- ── Content ── -->
  <div class="relative mx-auto grid w-full max-w-[1240px] items-center gap-12 px-5 lg:grid-cols-[1.15fr_0.85fr]">
    <div>
      {profile.status.available && (
        <p class="mb-6 inline-flex items-center gap-2.5 border border-[var(--accent)]/40 px-3 py-1.5 font-mono text-[0.66rem] uppercase tracking-[0.2em] text-[var(--accent)]">
          <span class="h-1.5 w-1.5 rounded-full bg-[var(--accent)] animate-pulse-dot"></span>
          {loc(profile.status.label, lang)}
        </p>
      )}

      <p class="mb-2 font-mono text-sm tracking-[0.18em] text-[var(--accent)]">{t('hero.greeting')}</p>

      <h1 class="mb-4 font-display text-[clamp(2.1rem,7vw,4.4rem)] font-black leading-[1.02]">
        <span data-hero-name data-text={profile.shortName}>{profile.shortName}</span>
      </h1>

      <p class="mb-6 flex min-h-[2rem] items-center font-display text-[clamp(0.95rem,2.6vw,1.4rem)] text-[var(--ink-2)]">
        <span data-typing data-roles={JSON.stringify(roles)}></span>
        <span class="ml-0.5 inline-block w-[2px] self-stretch bg-[var(--accent)] animate-blink" aria-hidden="true"></span>
      </p>

      <p class="mb-9 max-w-xl text-[1.05rem] leading-relaxed text-[var(--ink-2)]" set:html={pitchHtml}></p>

      <div class="flex flex-wrap items-center gap-3">
        <a href="#projects" data-navlink="projects" class="btn clip-corner">{t('hero.cta.work')}</a>
        <a href={profile.cv[lang]} target="_blank" rel="noopener" class="btn btn-ghost clip-corner">
          {t('hero.cta.cv')}
        </a>

        <div class="ml-1 flex items-center gap-1.5">
          {heroSocials.map((s) => (
            <a
              href={s.url}
              target={s.url.startsWith('http') ? '_blank' : undefined}
              rel="noopener noreferrer"
              aria-label={s.label}
              class="grid h-10 w-10 place-items-center border border-[var(--hair)] text-[var(--ink-3)] transition-all duration-300 hover:-translate-y-1 hover:border-[var(--accent)] hover:text-[var(--accent)]"
            >
              <SocialIcon name={s.icon} />
            </a>
          ))}
        </div>
      </div>
    </div>

    <!-- Desktop only: never downloaded on phones. -->
    <div class="hidden lg:block">
      <Hologram client:media="(min-width: 1024px)" />
    </div>
  </div>

  <a
    href="#about"
    data-navlink="about"
    class="absolute bottom-7 left-1/2 hidden -translate-x-1/2 flex-col items-center gap-2 font-mono text-[0.62rem] uppercase tracking-[0.25em] text-[var(--ink-3)] transition-colors hover:text-[var(--accent)] md:flex"
  >
    {t('hero.scroll')}
    <span class="h-9 w-px bg-gradient-to-b from-[var(--accent)] to-transparent"></span>
  </a>
</section>

<script>
  import { onView, gsap, prefersReducedMotion } from '../../lib/motion';
  import { scramble } from '../../lib/scramble';
  import { initParticles } from '../../lib/particles';

  onView(() => {
    const stops: Array<() => void> = [];
    const reduced = prefersReducedMotion();

    /* Name decodes out of noise on arrival. */
    const name = document.querySelector<HTMLElement>('[data-hero-name]');
    if (name && !reduced) stops.push(scramble(name, name.dataset.text ?? '', 1100));

    /* Role rotator. */
    const typing = document.querySelector<HTMLElement>('[data-typing]');
    if (typing) {
      const roles: string[] = JSON.parse(typing.dataset.roles ?? '[]');
      if (reduced) {
        typing.textContent = roles[0] ?? '';
      } else {
        let role = 0, char = 0, deleting = false, timer = 0;
        const step = () => {
          const word = roles[role] ?? '';
          char += deleting ? -1 : 1;
          typing.textContent = word.slice(0, char);
          let wait = deleting ? 45 : 95;
          if (!deleting && char === word.length) { wait = 1900; deleting = true; }
          else if (deleting && char === 0) { deleting = false; role = (role + 1) % roles.length; wait = 400; }
          timer = window.setTimeout(step, wait);
        };
        step();
        stops.push(() => clearTimeout(timer));
      }
    }

    stops.push(initParticles(document.querySelector<HTMLCanvasElement>('#particles')));

    if (!reduced) {
      /* Scroll parallax: deeper layers travel further. */
      const layerEls = document.querySelectorAll<HTMLElement>('[data-layer]');
      layerEls.forEach((el) => {
        const depth = Number(el.dataset.depth ?? 0.1);
        gsap.to(el, {
          yPercent: depth * 55,
          ease: 'none',
          scrollTrigger: { trigger: '#home', start: 'top top', end: 'bottom top', scrub: 0.6 },
        });
      });

      /* Pointer parallax, damped, on top of the scroll offset. */
      const root = document.querySelector<HTMLElement>('[data-parallax-root]');
      if (root && matchMedia('(pointer: fine)').matches) {
        const quick = [...layerEls].map((el) => ({
          x: gsap.quickTo(el, 'x', { duration: 0.9, ease: 'power3' }),
          depth: Number(el.dataset.depth ?? 0.1),
        }));
        const onMove = (e: PointerEvent) => {
          const dx = e.clientX / innerWidth - 0.5;
          quick.forEach((q) => q.x(-dx * q.depth * 140));
        };
        window.addEventListener('pointermove', onMove, { passive: true });
        stops.push(() => window.removeEventListener('pointermove', onMove));
      }

      /* Content lifts in behind the city. */
      gsap.from('#home h1, #home p, #home .btn', {
        y: 26, opacity: 0, duration: 0.9, stagger: 0.07, ease: 'power3.out', delay: 0.15,
        clearProps: 'opacity,transform',
      });
    }

    return () => stops.forEach((s) => s());
  });
</script>

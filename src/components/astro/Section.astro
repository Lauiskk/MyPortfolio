---
interface Props {
  id: string;
  index: string;
  title: string;
  /** Re-points --accent for everything inside. */
  accent?: 'cyan' | 'magenta' | 'purple' | 'blue';
  class?: string;
  full?: boolean;
}
const { id, index, title, accent = 'cyan', class: className = '', full = false } = Astro.props;
---
<section id={id} data-accent={accent} class={`relative py-24 md:py-32 ${className}`}>
  <div class={full ? '' : 'mx-auto max-w-[1240px] px-5'}>
    <h2 class="mb-12 flex items-center gap-4 font-display text-2xl md:text-3xl">
      <span class="font-mono text-sm text-[var(--accent)] opacity-70">{index}.</span>
      <span data-scramble data-text={title}>{title}</span>
      <span class="rule flex flex-1 items-center" aria-hidden="true"></span>
    </h2>
    <slot />
  </div>
</section>

<style is:global>
  [data-accent='cyan']    { --accent: var(--color-cyan);    --accent-2: var(--color-blue); }
  [data-accent='magenta'] { --accent: var(--color-magenta); --accent-2: var(--color-pink); }
  [data-accent='purple']  { --accent: var(--color-purple);  --accent-2: var(--color-magenta); }
  [data-accent='blue']    { --accent: var(--color-blue);    --accent-2: var(--color-cyan); }

  /* Neon on near-white is unreadable, so light mode gets darkened accents
     that still keep each section distinguishable from its neighbours. */
  [data-theme='light'] [data-accent='cyan']    { --accent: #0086a8; --accent-2: #0068c9; }
  [data-theme='light'] [data-accent='magenta'] { --accent: #b0009c; --accent-2: #c2005a; }
  [data-theme='light'] [data-accent='purple']  { --accent: #7a00d4; --accent-2: #b0009c; }
  [data-theme='light'] [data-accent='blue']    { --accent: #0068c9; --accent-2: #0086a8; }

  /* OVERDRIVE overrides every per-section accent. */
  [data-overdrive='true'] [data-accent] {
    --accent: var(--color-magenta);
    --accent-2: var(--color-yellow);
  }
</style>
